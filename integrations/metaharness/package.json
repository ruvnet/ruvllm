{
  "name": "@ruvector/ruvllm-gpu-loop",
  "version": "1.1.1",
  "type": "module",
  "description": "RuVLLM GPU job loop: bounded weight experiments, a durable GPU job scheduler with a Vast.ai host adapter, adapter archives and verified paired measurements (split out of @ruvector/ruvllm 4.0.x)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/ruvllm.git",
    "directory": "integrations/metaharness"
  },
  "homepage": "https://github.com/ruvnet/ruvllm/tree/main/integrations/metaharness#readme",
  "bugs": {
    "url": "https://github.com/ruvnet/ruvllm/issues"
  },
  "keywords": [
    "ruvllm",
    "ruvllm-gpu-loop",
    "metaharness",
    "lora",
    "adapters",
    "gpu",
    "gpu-scheduler",
    "vast.ai",
    "evaluation",
    "weight-editing",
    "ruvector"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ruvllm-gpu": "src/cli.mjs",
    "ruvllm-gpu-loop": "src/gpu-loop-cli.mjs",
    "ruvllm-adapters": "src/adapters-cli.mjs"
  },
  "exports": {
    ".": "./src/engine.mjs",
    "./adapters": "./src/adapters.mjs",
    "./fixture": "./src/fixture.mjs",
    "./gpu-loop": "./src/gpu-loop.mjs",
    "./gpu-host": "./src/gpu-host.mjs",
    "./gpu-spool-adapter": "./src/gpu-spool-adapter.mjs",
    "./vast-host-adapter": "./src/vast-host-adapter.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "examples/",
    "README.md",
    "GPU-LOOP.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "guard:name": "node scripts/check-package-name.mjs",
    "test": "node --test test/*.test.mjs",
    "bench": "node bench/run.mjs",
    "prepack": "cp ../../LICENSE ../../NOTICE .",
    "postpack": "rm -f LICENSE NOTICE",
    "prepublishOnly": "node scripts/check-package-name.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@metaharness/darwin": "^0.13.0",
    "@metaharness/flywheel": "^0.1.13",
    "@metaharness/weight-eft": "^0.1.2"
  }
}
